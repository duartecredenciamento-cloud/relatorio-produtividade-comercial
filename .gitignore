# Python e ambientes locais
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Segredos e configurações locais
.env
.env.*
!.env.example
*.pem
*.key
*.json
!config.json

# Dados operacionais e arquivos de execução
